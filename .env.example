# Copy to .env and fill in. Never commit .env.

# "offline" needs no key (rule-based classifier, templated replies).
# "openai" uses the LLM for classification, grounded answers and reply polishing.
SUPPORT_LLM_PROVIDER=offline
OPENAI_API_KEY=
SUPPORT_OPENAI_MODEL=gpt-4o-mini

# Optional: require this key in the X-API-Key header on /v1/* endpoints.
SUPPORT_API_KEY=

SUPPORT_RETRIEVAL_THRESHOLD=0.20
SUPPORT_MAX_CLARIFICATIONS=1
SUPPORT_LOG_LEVEL=INFO
